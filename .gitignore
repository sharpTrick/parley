# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test / coverage
coverage/

# SQLite scratch DBs (tests + local runs)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-*

# Parley local read-state (per-instance cursor store)
.parley-state/
read-state.json

# Secrets — backend_config / .env live here, NEVER committed (DESIGN §14)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.log
.idea/
.vscode/

# Local project tooling metadata (not part of the repo)
.project.yml

# Throwaway probe scripts written at the repo root while investigating a backend by hand.
# They import from dist/ and are never part of a package; a real test lives under a package's
# test/ directory instead.
/probe*.mjs
/probe*.ts
/scratch*.mjs
/.*-smoke.mjs
