{
  "name": "@sharptrick/parley-redis",
  "version": "0.1.0",
  "type": "module",
  "description": "@sharptrick/parley-redis — event-driven Parley backend on Redis Streams: one stream per topic, XADD id as both cursor and backendMsgId, XRANGE for exclusive-since catch-up, and a blocking XREAD loop for live push.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sharpTrick/parley.git",
    "directory": "packages/bridge-redis"
  },
  "homepage": "https://github.com/sharpTrick/parley/tree/main/packages/bridge-redis#readme",
  "bugs": {
    "url": "https://github.com/sharpTrick/parley/issues"
  },
  "author": {
    "name": "Patrick Sharp",
    "url": "https://github.com/sharpTrick"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "parley-redis": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --root ../.. packages/bridge-redis",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sharptrick/parley-core": "^0.1.0",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@sharptrick/parley-conformance": "^0.1.0"
  },
  "keywords": [
    "mcp",
    "parley",
    "redis",
    "message-bus",
    "agent-messaging"
  ]
}
