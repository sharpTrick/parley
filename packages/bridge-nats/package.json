{
  "name": "@sharptrick/parley-nats",
  "version": "0.1.0",
  "type": "module",
  "description": "@sharptrick/parley-nats — Parley backend on NATS JetStream: one stream per topic, the per-topic stream sequence as the cursor and an incarnation-qualified sequence as the backendMsgId, and a self-rebuilding ephemeral consumer for live push.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sharpTrick/parley.git",
    "directory": "packages/bridge-nats"
  },
  "homepage": "https://github.com/sharpTrick/parley/tree/main/packages/bridge-nats#readme",
  "bugs": {
    "url": "https://github.com/sharpTrick/parley/issues"
  },
  "author": {
    "name": "Patrick Sharp",
    "url": "https://github.com/sharpTrick"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "parley-nats": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sharptrick/parley-core": "^0.1.0",
    "nats": "^2.29.3"
  },
  "devDependencies": {
    "@sharptrick/parley-conformance": "^0.1.0"
  },
  "keywords": [
    "mcp",
    "parley",
    "nats",
    "message-bus",
    "agent-messaging"
  ]
}
