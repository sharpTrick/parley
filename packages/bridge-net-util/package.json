{
  "name": "@sharptrick/parley-net-util",
  "version": "0.1.0",
  "type": "module",
  "description": "@sharptrick/parley-net-util — tiny HTTP helper for Parley backends: one fetchWithRetry loop (429 / Retry-After / backoff clamp / deadline / error-body redaction) plus the shared delay every backend that waits uses. NOT bridge-core: the seam itself stays dependency-free and HTTP-free. Lockstep-published with the rest of Parley (semantic-release, no hand-versioning).",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sharpTrick/parley.git",
    "directory": "packages/bridge-net-util"
  },
  "homepage": "https://github.com/sharpTrick/parley/tree/main/packages/bridge-net-util#readme",
  "bugs": {
    "url": "https://github.com/sharpTrick/parley/issues"
  },
  "author": {
    "name": "Patrick Sharp",
    "url": "https://github.com/sharpTrick"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "prepublishOnly": "npm run build",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "mcp",
    "parley",
    "http",
    "retry",
    "message-bus",
    "agent-messaging"
  ]
}
