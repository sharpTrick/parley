{
  "name": "@sharptrick/parley-net-util",
  "version": "0.1.0",
  "type": "module",
  "description": "@sharptrick/parley-net-util — the helpers Parley's backends share below the seam: one fetchWithRetry loop (429 / Retry-After header+body / attempt + wall-clock deadline / bounded response read / error-body redaction), the plaintext-credential and loopback classifier every backend's connect() warning asks, the renderer that puts a rejected backend_config value in an error without disclosing what it holds, and the shared delay. NOT bridge-core: the seam itself stays dependency-free and HTTP-free. Lockstep-published with the rest of Parley (semantic-release, no hand-versioning).",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sharpTrick/parley.git",
    "directory": "packages/bridge-net-util"
  },
  "homepage": "https://github.com/sharpTrick/parley/tree/main/packages/bridge-net-util#readme",
  "bugs": {
    "url": "https://github.com/sharpTrick/parley/issues"
  },
  "author": {
    "name": "Patrick Sharp",
    "url": "https://github.com/sharpTrick"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "prepublishOnly": "npm run build",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "mcp",
    "parley",
    "http",
    "retry",
    "retry-after",
    "rate-limit",
    "backoff",
    "redaction",
    "secret-redaction",
    "plaintext-credentials",
    "loopback",
    "config-validation",
    "message-bus",
    "agent-messaging"
  ],
  "peerDependencies": {
    "vitest": "^2",
    "typescript": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
