{
  "name": "@sharptrick/parley-xmpp",
  "version": "0.1.0",
  "type": "module",
  "description": "@sharptrick/parley-xmpp — Parley backend on XMPP MUC rooms, using MAM for exclusive-since catch-up (the server MUST have MAM enabled). Archive id as both cursor and backendMsgId; live push rides the joined-room message stream.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sharpTrick/parley.git",
    "directory": "packages/bridge-xmpp"
  },
  "homepage": "https://github.com/sharpTrick/parley/tree/main/packages/bridge-xmpp#readme",
  "bugs": {
    "url": "https://github.com/sharpTrick/parley/issues"
  },
  "author": {
    "name": "Patrick Sharp",
    "url": "https://github.com/sharpTrick"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "parley-xmpp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck:test": "tsc -b tsconfig.test.json",
    "clean": "tsc -b --clean",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sharptrick/parley-core": "^0.1.0",
    "@sharptrick/parley-net-util": "^0.1.0",
    "@xmpp/client": "^0.14.0"
  },
  "devDependencies": {
    "@sharptrick/parley-conformance": "^0.1.0"
  },
  "keywords": [
    "mcp",
    "parley",
    "xmpp",
    "message-bus",
    "agent-messaging"
  ]
}
